# 雨城通「问一问」QQ 机器人配置
# 复制本文件为 .env 后填写；.env 已被 .gitignore 忽略，不会提交到仓库。
# 同名进程环境变量优先级高于本文件，方便用 PM2 / 计划任务注入密钥。

# ── QQ 开放平台机器人（必填）──────────────────────────────
# 在 https://q.qq.com 机器人管理端「开发设置」里查看 AppID 和 AppSecret。
QQ_BOT_APP_ID=
QQ_BOT_APP_SECRET=

# ── 问一问（必填）────────────────────────────────────────
# 与网页端问一问使用同一个接口，Key 是模型服务商（DeepSeek / GLM / MiMo）的 API Key。
YCT_ASSISTANT_KEY=
# 机器人通常和网页服务在同一台服务器上，直连本机端口可以绕开 Nginx 和公网限流。
YCT_BASE_URL=http://127.0.0.1:3300
YCT_ASSISTANT_PROVIDER=deepseek
YCT_ASSISTANT_MODEL=deepseek-v4-flash
YCT_ASSISTANT_LOCALE=zh-CN

# ── 可选：默认值已能正常工作，需要时再取消注释 ─────────────
# QQ_BOT_STYLE=chat
# QQ_BOT_CHAT_MAX_CHARS=360
# QQ_BOT_CONDENSE=1
# QQ_BOT_CONDENSE_CHARS=180
# QQ_BOT_API_BASE=https://api.bot.qq.com
# QQ_BOT_INTENTS=33554432
# QQ_BOT_GROUP_ALLOWLIST=
# QQ_BOT_USER_QPM=6
# QQ_BOT_GROUP_QPM=20
# 同时处理的问一问数量，默认 3；超出的按会话排队，单会话最多再挂 2 条。
# 回答本身要几十秒，调大并发能减少群里排队，但要同步看模型服务商的并发额度。
# QQ_BOT_MAX_CONCURRENCY=3
# 排障用：把每条网关事件打一行 [trace]，含事件类型、消息 id、打码后的群/成员和内容长度。
# 平时保持关闭；排查“某人 @ 了没反应”时打开，能区分事件没到和机器人内部丢弃。
# QQ_BOT_TRACE=0
# QQ_BOT_MAX_QUESTION_CHARS=1000
# QQ_BOT_SEGMENT_CHARS=900
# QQ_BOT_ACK=1
# 流式首段：模型还在生成时先把第一个完整句子发出去，明显缩短群里的等待；默认关。
# 只在首段达到 QQ_BOT_STREAM_MIN_CHARS 字并以句号/问号等结尾时才发，表格和代码块会等完整。
# QQ_BOT_STREAM_FIRST=0
# QQ_BOT_STREAM_MIN_CHARS=100
# QQ_BOT_APPEND_SOURCES=0
# QQ_BOT_LINKS=0
# QQ_BOT_FOLLOWUPS=0
# QQ_BOT_ANSWER_TIMEOUT_MS=120000
# QQ_BOT_WEATHER_CITY=上海
# QQ_BOT_AMAP_KEY=
# QQ_BOT_STATE_PATH=state/qq-bot-state.json
# YCT_PUBLIC_BASE_URL=
# QQ_BOT_IMAGES=1
# LDPASS_API_BASE_URL=https://ldpass.example.com
# QQ_BOT_LINK_SECRET=
# QQ_BOT_CONTEXT_SECRET=
# 群聊绑定：群里 @机器人 /绑定 生成一次性链接，再 /确认 6 位码；默认开启
# QQ_GROUP_LINK_ENABLED=1
# 群 token 内存缓存：TTL 以 5 分钟和服务端 expiresAt 中更早者为准
# QQ_BOT_GROUP_LINK_TTL_MS=300000
# QQ_BOT_GROUP_LINK_CACHE_MAX=10000
# 临东通绑定接口超时；公网偶发慢请求时可调大，默认 20 秒
# QQ_BOT_LINK_TIMEOUT_MS=20000
# QQ_BOT_CARDS=1
# QQ_BOT_CARD_FONT_DIR=./assets/fonts
# QQ_BOT_CARD_ASSET_DIR=./assets
# QQ_BOT_BILIBILI=1
# QQ_BOT_IMAGE_HOSTS=
# QQ_BOT_FORTUNE_TEXTS_PATH=data/fortune-texts.txt
# QQ_BOT_GROUP_NOTICES_PATH=data/group-notices.json
# QQ_BOT_GROUP_ALIASES=

# ── 可选：随机物料（物料盲盒）──────────────────────────
# 物料出图由网页端 /api/qq-bot/materials/render 完成，两边必须配置同一个 HMAC secret：
# 机器人读 QQ_BOT_MATERIAL_SECRET，网页端优先读 YCT_QQ_MATERIAL_SECRET、兼容同名变量。
# 没配置 secret 时物料指令只会提示「物料功能还没有配置完成」，不影响机器人其它功能。
# QQ_BOT_MATERIALS=1
# QQ_BOT_MATERIAL_SECRET=
# 单次出图请求超时，单位毫秒；网页端并发上限 2，超时会提示稍后再试。
# 首次出图要加载地图标记、线网和字体，冷启动可能十几秒，默认给到 20 秒。
# QQ_BOT_MATERIAL_TIMEOUT_MS=20000
# 按群物料数据源（服务器线网 / 沈阳示例线网）的保存文件，更新机器人时保留。
# QQ_BOT_MATERIAL_SOURCE_PATH=state/material-sources.json

# ── 可选：按群功能开关 ──────────────────────────────────
# 群开关文件放在 state/ 下，更新机器人时保留；不存在时所有功能按默认开启。
# QQ_BOT_GROUP_CONFIG_PATH=state/group-modules.json
# 开关审计文件，默认与配置文件同目录的 module-audit.jsonl。
# QQ_BOT_MODULE_AUDIT_PATH=state/module-audit.jsonl
# 谁能在群里改开关：owner=群主、admin=群管理员，逗号分隔；留空则只能靠白名单。
# QQ_BOT_MODULE_EDITORS=owner,admin
# 平台事件缺少 member_role 时的兜底白名单，格式 群openid:成员openid，逗号或空格分隔。
# QQ_BOT_MODULE_ADMINS=
# 功能被关闭后是否提示：同群同功能默认 10 分钟只提示一次。
# QQ_BOT_MODULE_HINTS=1
# QQ_BOT_MODULE_HINT_TTL_MS=600000
# 有问一问范围被关闭时，「正在查资料」延后多久发送，避免秒回拦截时先提示再没下文。
# QQ_BOT_ACK_DELAY_MS=1000
# 玩家进出播报：QQ_BOT_PLAYER_EVENTS=1 只启动轮询；
# 具体发到哪些群由群里的 /模块 开 玩家进出播报 决定，默认关闭。
# 旧版 QQ_BOT_PLAYER_EVENT_GROUPS 已废弃，群列表改由 state/group-modules.json 管理。
# QQ_BOT_PLAYER_EVENTS=0
# QQ_BOT_PLAYER_POLL_MS=30000
# QQ_BOT_PLAYER_JOIN_TEXT=🟢 {name} 进入了服务器
# QQ_BOT_PLAYER_LEAVE_TEXT=🔴 {name} 离开了服务器
# 服务器事件桥：QQ_BOT_EVENT_PORT>0 才会监听。
# 游戏聊天发到哪些群由 /模块 开 服务器消息 决定；
# 旧版 QQ_BOT_EVENT_GROUPS 已废弃，群列表改由 state/group-modules.json 管理。
# QQ_BOT_EVENT_PORT=0
# QQ_BOT_EVENT_BIND=127.0.0.1
# QQ_BOT_EVENT_TOKEN=
# QQ_BOT_EVENT_GROUP_MAP=
# 运维提醒：部署脚本 POST /ops 时使用；为空时 /ops 接口关闭。
# 提醒通过私聊发给“给机器人发过消息的好友”，不再发群；群模块里没有运维提醒开关。
# 需要同时把 QQ_BOT_EVENT_PORT 设成非 0 端口，并把同样 token 传给 notify-ops.ps1。
# QQ_BOT_OPS_TOKEN=
# QQ_BOT_OPS_STATE_PATH=state/ops-reminders.json
# QQ_BOT_OPS_RECIPIENT_PATH=state/ops-recipients.json
# QQ_BOT_LOG_LEVEL=info
